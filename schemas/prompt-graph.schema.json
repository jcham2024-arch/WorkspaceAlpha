{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://workspacealpha.example.com/schemas/prompt-graph.schema.json",
  "title": "Prompt DAG",
  "description": "Prompt DAG schema. The JSON at .context/prompt-graph.json is the runtime source of truth; .context/prompt-graph.yaml is a generated mirror kept in sync by tools/sync_prompt_graph.py and checked by tools/validate_prompt_graph.py.",
  "type": "object",
  "required": [
    "version",
    "nodes",
    "edges"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0.0"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "content_ref"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "SystemPrompt",
              "Skill",
              "Envelope",
              "ContextSlice",
              "Adapter",
              "OutputContract",
              "RetrievalProtocol"
            ]
          },
          "content_ref": {
            "type": "string",
            "description": "Reference to a manifest node ID or a file path. ContextSlice nodes reference manifest node IDs by byte_range."
          },
          "tier": {
            "type": "string",
            "description": "Skill lifecycle tier (core|curated|experimental|quarantine) for most node types; agent tier (orchestrator|manager|worker) for RetrievalProtocol nodes.",
            "enum": [
              "core",
              "curated",
              "experimental",
              "quarantine",
              "orchestrator",
              "manager",
              "worker"
            ]
          },
          "token_budget": {
            "type": "integer",
            "minimum": 0
          },
          "trigger_condition": {
            "type": "string",
            "description": "YAML predicate for Skill nodes; included only when condition matches scope"
          },
          "metadata": {
            "type": "object",
            "description": "RetrievalProtocol nodes require metadata.protocol (DIRECT|STAIR|VECTOR|GRAPH|PATTERN) and metadata.tool."
          }
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "type"
        ],
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "requires",
              "triggers",
              "routes_to",
              "adapts",
              "provenance_of"
            ]
          },
          "condition": {
            "type": "string",
            "description": "Optional condition for conditional edges (triggers)"
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
