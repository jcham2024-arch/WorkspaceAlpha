    "coder": ["read_section", "search_nodes", "list_nodes", "knowledge_search", "knowledge_last"],
    "reviewer": ["read_section", "search_nodes", "list_nodes", "knowledge_search", "knowledge_last"],
    "taskmaster": ["compile_context", "read_section", "search_nodes", "list_nodes", "knowledge_search", "knowledge_last"]
  }
}
